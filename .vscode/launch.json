{
	"version": "0.2.0",
	"configurations": [
	  {
		"name": "Debug btc",
		"type": "cppdbg",
		"request": "launch",
		"program": "${workspaceFolder}/ex01/RPN",
		"args": ["1 1 A +"],
		"stopAtEntry": false,
		"cwd": "${workspaceFolder}/ex01",
		"environment": [],
		"externalConsole": false,
		"MIMode": "gdb",
		"setupCommands": [
		  {
			"description": "Enable pretty-printing for gdb",
			"text": "-enable-pretty-printing",
			"ignoreFailures": true
		  }
		],
		"preLaunchTask": "Build with Make"
	  }
	]
  }