{
	"version": "0.2.0",
	"configurations": [
	  {
		"name": "Debug PmergeMe",
		"type": "cppdbg",
		"request": "launch",
		"program": "${workspaceFolder}/ex02/PmergeMe",
		"args": ["1", "2", "3", "4", "5", "6", "7", "8"],
		"stopAtEntry": false,
		"cwd": "${workspaceFolder}/ex02",
		"environment": [],
